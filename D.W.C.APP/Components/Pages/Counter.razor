@page "/calendar"

@using Radzen
@using Radzen.Blazor


@code {
    private List<Appointment> appointments = new List<Appointment>
    {
        new Appointment { Start = DateTime.Now, End = DateTime.Now.AddHours(1), Text = "Spotkanie" }
    };

    private Appointment selectedAppointment = new Appointment();
    private bool isDialogVisible = false;

    public class Appointment
    {
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public string Text { get; set; }
    }

    private void ShowDialog()
    {
        selectedAppointment = new Appointment { Start = DateTime.Now, End = DateTime.Now.AddHours(1) };
        isDialogVisible = true;
    }

    private void SaveAppointment()
    {
        if (!appointments.Contains(selectedAppointment))
        {
            appointments.Add(selectedAppointment);
        }
        isDialogVisible = false;
    }

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Appointment> args)
    {
        selectedAppointment = args.Data;
        isDialogVisible = true;
    }
}
